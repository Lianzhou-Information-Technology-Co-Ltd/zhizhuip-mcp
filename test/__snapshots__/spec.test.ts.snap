    "destructive": false,
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "countryList": {
          "description": "国家编码，多个以英文逗号分隔（动态产品用）",
          "type": "string",
        },
        "customUsername": {
          "description": "按自定义账号搜索（时长类产品用）",
          "type": "string",
        },
        "ids": {
          "description": "子账号 id 集合，多个以英文逗号连接（时长类产品用）",
          "type": "string",
        },
        "page": {
          "description": "当前页数",
          "type": "integer",
        },
        "pagesize": {
          "description": "每页显示数量。每页最大100条数据",
          "type": "integer",
        },
        "product": {
          "description": "产品：dynamic-no-expiry=动态住宅流量（永久），dynamic-monthly=动态住宅流量（期限），static-standard=静态住宅（非原生），static-native=静态住宅（原生），static-isp-native=静态住宅（运营商原生），static-ipv6=静态住宅（IPv6），datacenter=数据中心",
          "enum": [
            "dynamic-no-expiry",
            "dynamic-monthly",
            "static-standard",
            "static-native",
            "static-isp-native",
            "static-ipv6",
            "datacenter",
          ],
          "type": "string",
        },
        "remark": {
          "description": "按备注模糊搜索（动态产品用）",
          "type": "string",
        },
        "searchArr": {
          "description": "搜索值列表，与 search_type 配合（时长类产品用）",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "search_type": {
          "description": "搜索类型：0=自定义账密，1=子账号 IP，2=备注；搜索值放 searchArr（时长类产品用）",
          "enum": [
            0,
            1,
            2,
          ],
          "type": "integer",
        },
        "subAccounts": {
          "description": "子账号 id 集合，多个以英文逗号连接（动态产品用）",
          "type": "string",
        },
      },
      "required": [
        "product",
        "page",
        "pagesize",
      ],
      "type": "object",
    },
